#version 450

layout(local_size_x = 16, local_size_y = 16) in;

// Output Image
layout(rgba32f, binding = 0) uniform image2D img_output;

#define UNDEF_MATERIAL 0
#define PHONG_MATERIAL 1

// Debug: visualize SSBO contents
#define DEBUG_SSBO 0

// All structs below are supposedly 16-bytes aligned

struct Mesh {
  int nVertices;
  int vStart;
  int nTriangles;
  int tStart;
};

struct Vertex {
  // Vec4 for padding
  vec4 p, n;
};

struct Material {
  // For ambient, diffuse and specular, vec4 used for padding, w = constant (kA,
  // kS or kD)
  vec4 ambient;
  vec4 diffuse;
  vec4 specular;
  float shininess;
  int type;
  int pad1, pad2; // Pad to 16-byte boundary
};

struct Object {
  int meshID;
  int materialID;
};

struct LightSource {
  vec4 pos;   // w = intensity
  vec4 color; // w = isActive (1 = true, 0 = false)
};

// SSBOs (used as read-only)

layout(std430, binding = 1) buffer VertexBuffer { Vertex data[]; }
vertices;
layout(std430, binding = 2) buffer TriangleBuffer { uint data[]; }
indices;
layout(std430, binding = 3) buffer MeshBuffer { Mesh data[]; }
meshes;
layout(std430, binding = 4) buffer MaterialBuffer { Material data[]; }
materials;
layout(std430, binding = 5) buffer ObjectBuffer { Object data[]; }
objects;
layout(std430, binding = 6) buffer LightBuffer { LightSource data[]; }
lights;

// Global parameters

uniform int w, h;

uniform int nLights, nTriangles;

// Perspective camera, we suppose that the aspect ratio is the same as that of
// the screen
struct Camera {
  vec3 eye;
  vec3 at;
  vec3 up;
  float fov;
  float near;
  float far;
};

uniform Camera camera;

// Struct for data handling inside the shader

struct Ray {
  vec3 eye;
  vec3 direction;
};

struct Sphere {
  vec3 C;
  float r;
};

struct Triangle {
  Vertex v1, v2, v3;
};

// used to store hits
struct Hit {
  vec3 p;          // Position
  vec3 n;          // Normal
  float t;         // Parameter of the ray
  bool front_face; // Tells whether the ray has hit the object from the outside
};

struct Hittable {
  int type;
};

// Calculates point along ray for parameter t
vec3 at(Ray r, float t) { return r.eye + t * r.direction; }

bool hits(Sphere s, Ray r, float tmin, float tmax, out Hit hit) {
  // Computation of the intersection with the sphere
  // Given P(t) = at(r,t), we have an intersection along the ray iff
  // there is a t > 0 such as (C - P(t))·(C - P(t)) == r²
  // This can be written (C - eye)·(C - eye) - 2 t (C - eye)·direction + t²
  // direction·direction = r² It is a 2nd degree equation, we solve for t, and
  // deduce there is one or more intersections iff delta = 4 ((C -
  // eye)·direction)² - 4 (|C - eye|² - r²) >= 0

  // C - eye
  vec3 cme = s.C - r.eye;
  // h = -2b
  float h = dot(cme, r.direction);
  float c = dot(cme, cme) - s.r * s.r;
  float delta = h * h - c;

  if (delta > 0) {
    float t = h - sqrt(delta);
    if (tmin <= t && t <= tmax) {
      hit.p = at(r, t);
      // The normal is simply the center to point vector, normalized
      hit.n = normalize(hit.p - s.C);
      hit.t = t;
      // We check whether the ray has hit the sphere from the inside
      hit.front_face = dot(r.direction, hit.n) < 0;
      // If it is the case, we change the normal to point the other way
      // hit.n = hit.front_face ? hit.n : -hit.n;
      return true;
    } else
      return false;
  } else
    return false;
}

bool hits(Triangle tri, Ray r, float tmin, float tmax, out Hit hit) {
  // Implementation of the Möller-Trumbore algorithm
  vec3 e1 = tri.v2.p.xyz - tri.v1.p.xyz;
  vec3 e2 = tri.v3.p.xyz - tri.v1.p.xyz;
  vec3 rxe2 = cross(r.direction, e2);
  float det = dot(e1, rxe2);

  // We consider the ray is parallel
  if (abs(det) < 0.0001)
    return false;

  float idet = 1.0 / det;
  vec3 s = r.eye - tri.v1.p.xyz;
  float u = idet * dot(s, rxe2);

  if (u < 0.0 || u > 1.0)
    return false;

  vec3 sxe1 = cross(s, e1);
  float v = idet * dot(r.direction, sxe1);

  if (v < 0.0 || u + v > 1.0)
    return false;

  // At this stage we can compute t to find out where the intersection point is
  // on the line.
  float t = idet * dot(e2, sxe1);

  if (t > tmin && t < tmax) {
    // Yeepee, there is an intersection
    hit.t = t;
    hit.p = r.eye + r.direction * t;

    // Barycentric interpolation for the normal, with our calculated weights
    float w = 1.0 - u - v;
    hit.n = normalize(w * tri.v1.n.xyz + u * tri.v2.n.xyz + v * tri.v3.n.xyz);
    // We check whether the ray has hit the triangle from the front or back face
    hit.front_face = dot(r.direction, hit.n) < 0;
    // If it is the case, we change the normal to point the other way
    // hit.n = hit.front_face ? hit.n : -hit.n;
    return true;
  }

  return false;
}

bool nearestHit(Ray r, float tmin, float tmax, out Hit hit, out int tri) {
  // We check for all primitives in the scene
  // For now, only triangles
  hit.t = tmax;
  bool did_hit = false;
  float closest_now = tmax;
  for (int i = 0; i < nTriangles; i++) {
    uint i0 = indices.data[3 * i];
    uint i1 = indices.data[3 * i + 1];
    uint i2 = indices.data[3 * i + 2];
    Triangle t =
        Triangle(vertices.data[i0], vertices.data[i1], vertices.data[i2]);
    if (hits(t, r, tmin, closest_now, hit)) {
      did_hit = true;
      tri = i;
      closest_now = hit.t;
    }
  }
  return did_hit;
}

// Shading with materials

vec3 defaultShade(Hit hit, Material material) {
  switch (material.type) {
  case PHONG_MATERIAL:
    return material.ambient.rgb * material.ambient.w;
  case UNDEF_MATERIAL:
    return vec3(0);
  default:
    return vec3(0);
  }
}

vec3 shade(Hit hit, Material material, LightSource light) {
  switch (material.type) {
  case PHONG_MATERIAL:
    vec3 lightPos = light.pos.xyz;
    float intensity = light.pos.w;

    vec3 L = lightPos - hit.p;
    float dist = length(L);
    vec3 lv = L / dist;

    vec3 v = normalize(camera.eye - hit.p);
    vec3 h = normalize(lv + v); // Halfway vector for Blinn-Phong

    // Distance Attenuation (in 1 / d²) to make it look realistic, incorporating
    // intensity A small epsilon is added to prevent division by 0
    float attenuation = intensity / (dist * dist + .01);

    // We calculate diffuse and specular components
    // Diffuse Component
    float diffCoeff = max(dot(hit.n, lv), 0.);
    vec3 diffuse =
        light.color.rgb * material.diffuse.rgb * diffCoeff * material.diffuse.w;

    // 4. Specular Component
    float specCoeff = pow(max(dot(hit.n, h), 0.), material.shininess);
    vec3 specular = light.color.rgb * material.specular.rgb * specCoeff *
                    material.specular.w;

    // 5. Combine with attenuation
    return (diffuse + specular) * attenuation;

  case UNDEF_MATERIAL:
    return vec3(0.);
  default:
    return vec3(0.);
  }
}

void main() {
#if DEBUG_SSBO
  vec3 v0 = vertices.data[0].p.xyz * 0.5 + 0.5;
  vec3 i0 = vec3(float(indices.data[0]) / 10.0, float(indices.data[1]) / 10.0,
                 float(indices.data[2]) / 10.0);
  vec3 dbg = (nTriangles > 0) ? v0 : i0;
  imageStore(img_output, coords, vec4(dbg, 1));
  return;
#endif

  // gl_LocalInvocationID.xy * gl_WorkGroupID.xy == gl_GlobalInvocationID
  ivec2 coords = ivec2(gl_GlobalInvocationID);
  // We transform screen coordinates to place it in front of the camera, at the
  // near plane
  float near_h = 2 * camera.near * tan(radians(camera.fov) / 2);
  float near_w = near_h * float(w) / float(h);

  // Camera basis :
  vec3 forward = normalize(camera.at - camera.eye);
  vec3 right = normalize(cross(forward, camera.up));
  vec3 up = cross(right, forward);

  // We use the camera basis and the normalised coords (between -.5 and .5 and
  // y-axis reverted) to compute the 3d position of the pixel
  vec2 nc = vec2((2.0 * float(coords.x) / float(w) - 1.0) * near_w / 2.0,
                 (2.0 * float(coords.y) / float(h) - 1.0) * near_h / 2.0);
  vec3 pos3d = camera.eye + forward * camera.near + right * nc.x + up * nc.y;

  // The ray R(t) = eye_pos + t*ray_direction
  // FOV in degrees
  float fov = camera.fov;
  vec3 eye = camera.eye;
  Ray r = Ray(eye, normalize(pos3d - eye));
  // Sphere of radius r and center C
  Sphere s = Sphere(vec3(0.), 1);
  // Red material for the sphere
  Material sphereMat = {
      vec4(1, 0, 0, .2),
      vec4(1, 0, 0, .7),
      vec4(1, 1, 1, .01),
      32.,
      PHONG_MATERIAL,
      0,
      0,
  };
  // float alpha = coords.y / float(h);
  // vec3 blue = vec3(0, .2, 1);
  // vec3 white = vec3(1);
  // vec3 background_color = alpha * blue + (1 - alpha) * white;
  vec3 background_color = vec3(0.);

  // Default pixel value
  vec3 pixel = background_color;
  Hit hit;
  int tri;
  if (nearestHit(r, 0., 1. / 0., hit, tri)) {
    // We create as many rays as there are lights and look for intersections
    // along the way
    pixel = defaultShade(hit, sphereMat);
    bool lit = false;
    for (int i = 0; i < nLights; i++) {
      LightSource light = lights.data[i];
      // Shadow ray
      vec3 L = vec3(light.pos) - hit.p;
      Ray sr = {hit.p, normalize(L)};
      Hit obstacleHit;
      int triHit;
      if (!nearestHit(sr, 0.001, length(L), obstacleHit, triHit)) {
        // There is light (yepee)
        pixel += shade(hit, sphereMat, light);
      };
    }
  } else {
    Triangle first =
        Triangle(vertices.data[indices.data[0]], vertices.data[indices.data[1]],
                 vertices.data[indices.data[2]]);
    if (hits(first, r, 0., 1. / 0., hit))
      pixel = vec3(1.);
  }
  imageStore(img_output, coords, vec4(pixel, 1));
}