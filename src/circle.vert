void main() {
  localPos = quadVertices[gl_VertexID] * radius;
  int idx = gl_InstanceID * 3;
  vec3 worldOffset =
      vec3(positions[idx], positions[idx + 1], positions[idx + 2]);
  // Position in world space
  vec4 worldPos = vec4(localPos + worldOffset, 1.);

  isStatic = 0;
  baseColor = vec3(1.);
  if (gl_InstanceID < nStatic) {
    isStatic = 1;
  } else {
    float coeff =
        clamp(length(vec3(vel[idx], vel[idx + 1], vel[idx + 2])) / 50., 0, 1);
    baseColor = heatmap(coeff);
  }

  gl_Position = projection * worldPos;
}