#version 460 core

// Particle positions
layout(std430, binding = 0) readonly buffer InstanceData {
  float positions[]; // Tightly packed float array
};

layout(std430, binding = 1) readonly buffer Velocities { float vel[]; };

out vec3 localPos;
out vec3 baseColor;
out int isStatic;

uniform mat4 projection;
uniform float radius;
uniform int nStatic;

// Colors + position in [0,1] range (used if usepos = true)
vec4 heatmap_colors[5] =
    vec4[](vec4(0, 0, 1, 0), vec4(0, 1, 1, 0), vec4(0, 1, 0, 0),
           vec4(1, 1, 0, 0), vec4(1, 0, 0, 0));

vec3 heatmap(float coeff) {
  // Positions are not used for now
  int i0 = int(floor(4. * coeff));
  float alpha = fract(4. * coeff);
  int i1 = int(ceil(4. * coeff));
  return mix(heatmap_colors[i0].rgb, heatmap_colors[i1].rgb, alpha);
}

